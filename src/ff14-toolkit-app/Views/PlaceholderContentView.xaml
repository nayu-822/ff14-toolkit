<UserControl x:Class="FF14Toolkit.App.Views.PlaceholderContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="24"
                Style="{StaticResource SurfaceCardStyle}">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding PrimaryTitle}" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding PrimaryBody}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Padding="20"
                Style="{StaticResource SurfaceCardStyle}">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding SecondaryTitle}" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding SecondaryBody}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
