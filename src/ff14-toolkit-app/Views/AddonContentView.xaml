<UserControl x:Class="FF14Toolkit.App.Views.AddonContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Padding="20"
            Style="{StaticResource SurfaceCardStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding CharacterLabel}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding SelectedCharacterDisplay}" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding SourcePathLabel}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource AppAccentBrush}"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="{Binding SourcePath}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding DataSetLabel}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding DataSetName}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding ElementCountLabel}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding ElementCountText}" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding ScaledElementCountLabel}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding ScaledElementCountText}" />
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding UnresolvedCountLabel}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding UnresolvedCountText}" />
                </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Padding="16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MutedCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnresolvedEntries}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"
                                   Text="{Binding UnresolvedPanelTitle}" />
                        <TextBlock Grid.Row="2"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding UnresolvedPanelDescription}"
                                   TextWrapping="Wrap" />

                        <ItemsControl Grid.Row="4"
                                      ItemsSource="{Binding UnresolvedEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8,0,8"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock FontFamily="Consolas"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       Text="{Binding HashText}" />

                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource AppMutedTextBrush}"
                                                       Text="{Binding CountText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Margin="4,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding NameLabel}" />
                        <TextBlock Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding HashLabel}" />
                        <TextBlock Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding PositionLabel}" />
                        <TextBlock Grid.Column="3"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding SizeLabel}" />
                        <TextBlock Grid.Column="4"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding FlagsLabel}" />
                        <TextBlock Grid.Column="5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding ScaleLabel}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,10,0,10"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="4,0,12,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,4,0,0"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AppMutedTextBrush}"
                                                           Text="{Binding StateText}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppMutedTextBrush}"
                                                       Text="{Binding HashText}" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppMutedTextBrush}"
                                                       Text="{Binding PositionText}" />
                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppMutedTextBrush}"
                                                       Text="{Binding SizeText}" />
                                            <TextBlock Grid.Column="4"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppMutedTextBrush}"
                                                       Text="{Binding FlagsText}" />
                                            <TextBlock Grid.Column="5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppMutedTextBrush}"
                                                       Text="{Binding ScaleText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding StatusMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
