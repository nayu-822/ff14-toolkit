<Window x:Class="FF14Toolkit.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="320"
        Height="220"
        MinWidth="220"
        MinHeight="140"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStyle="None">
    <Grid Background="{x:Null}">
        <Border Margin="8"
                Background="#80FFFCF6"
                BorderBrush="#99C4DEC9"
                BorderThickness="1"
                CornerRadius="18"
                IsHitTestVisible="False" />

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderSurface"
                    Height="24"
                    Background="#A0DDEFE4"
                    CornerRadius="18,18,10,10"
                    IsHitTestVisible="False"
                    MouseLeftButtonDown="OnHeaderSurfaceMouseLeftButtonDown" />

            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource AppMutedTextBrush}"
                       IsHitTestVisible="False"
                       Text="{Binding ModeHint}" />

            <Thumb x:Name="ResizeThumb"
                   Grid.Row="2"
                   Width="34"
                   Height="34"
                   Margin="0,0,-4,-4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   IsHitTestVisible="False"
                   DragDelta="OnResizeThumbDragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Path Width="18"
                                  Height="18"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,4,4"
                                  Data="M 0 18 L 18 0"
                                  Stroke="#805A675E"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Path Width="12"
                                  Height="12"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,4,4"
                                  Data="M 0 12 L 12 0"
                                  Stroke="#A05A675E"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Grid>
</Window>
