<Window x:Class="FF14Toolkit.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="320"
        Height="220"
        MinWidth="220"
        MinHeight="140"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStyle="None">
    <Grid Background="{x:Null}">
        <Border Margin="8"
                Background="#80FFFCF6"
                BorderBrush="#99C4DEC9"
                BorderThickness="1"
                CornerRadius="18"
                IsHitTestVisible="False" />

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderSurface"
                    Height="24"
                    Background="#A0DDEFE4"
                    CornerRadius="18,18,10,10"
                    MouseLeftButtonDown="OnHeaderSurfaceMouseLeftButtonDown" />

            <Grid Grid.Row="1"
                  Margin="16,14,16,14"
                  IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding Title}" />
                    <Border Margin="10,0,0,0"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            CornerRadius="999"
                            Background="#D9E8F6E1">
                        <TextBlock FontSize="11"
                                   Foreground="#315443"
                                   Text="{Binding StatusText}" />
                    </Border>
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           FontSize="11"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding ModeHint}" />

                <TextBlock Grid.Row="2"
                           Margin="0,16,0,0"
                           FontSize="11"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="シーケンス" />
                <TextBlock Grid.Row="3"
                           Margin="0,4,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding SequenceName}" />

                <TextBlock Grid.Row="4"
                           Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="詳細" />
                <TextBlock Grid.Row="5"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding DetailText}" />

                <Grid Grid.Row="6"
                      Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="11"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="現在のアクション" />
                    <TextBlock Grid.Row="1"
                               Margin="0,4,12,0"
                               FontSize="12"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding CurrentActionText}" />

                    <TextBlock Grid.Column="1"
                               FontSize="11"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="サイクル" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding CycleText}" />

                    <TextBlock Grid.Row="2"
                               Margin="0,12,0,0"
                               FontSize="11"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="最後のキー" />
                    <TextBlock Grid.Row="3"
                               Margin="0,4,12,0"
                               FontSize="12"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding LastKeyText}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,12,0,0"
                               FontSize="11"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="更新" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{Binding UpdatedAtText}" />
                </Grid>
            </Grid>

            <Thumb x:Name="ResizeThumb"
                   Grid.Row="2"
                   Width="34"
                   Height="34"
                   Margin="0,0,-4,-4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   DragDelta="OnResizeThumbDragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Path Width="18"
                                  Height="18"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,4,4"
                                  Data="M 0 18 L 18 0"
                                  Stroke="#805A675E"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Path Width="12"
                                  Height="12"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,4,4"
                                  Data="M 0 12 L 12 0"
                                  Stroke="#A05A675E"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Grid>
</Window>
