<UserControl x:Class="FF14Toolkit.App.Views.CraftActionSequenceListContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Padding="24"
            Style="{StaticResource SurfaceCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Width="120"
                    HorizontalAlignment="Left"
                    Command="{Binding CreateSequenceCommand}"
                    Content="{Binding CreateButtonLabel}"
                    Style="{StaticResource PrimaryButtonStyle}" />

            <Border Grid.Row="2"
                    Padding="0,0,0,10"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Margin="4,0,0,0"
                               Text="{Binding NameColumnLabel}" />

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding EditColumnLabel}" />

                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding DeleteColumnLabel}" />
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RegisteredSequences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,12,0,12"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="4,0,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   Text="{Binding Name}" />

                                        <Button Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.EditSequenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding DataContext.EditButtonLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Style="{StaticResource QuietButtonStyle}" />

                                        <Button Grid.Column="3"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.DeleteSequenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding DataContext.DeleteButtonLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Style="{StaticResource QuietButtonStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding EmptyMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RegisteredSequences.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
