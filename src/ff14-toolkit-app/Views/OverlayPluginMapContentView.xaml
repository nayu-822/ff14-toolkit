<UserControl x:Class="FF14Toolkit.App.Views.OverlayPluginMapContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="24"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding RegionLabel}" />
                <TextBlock Grid.Row="2"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding RegionName}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="4"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding MapLabel}" />
                <TextBlock Grid.Row="6"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding MapName}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding TerritoryTypeIdLabel}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"
                                   Text="{Binding TerritoryTypeIdText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding MapIdLabel}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"
                                   Text="{Binding MapIdText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="16"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Image Stretch="Uniform"
                       Source="{Binding MapImage}" />

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding EmptyImageMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMapImage}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</UserControl>
