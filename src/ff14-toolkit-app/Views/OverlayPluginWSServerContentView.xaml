<UserControl x:Class="FF14Toolkit.App.Views.OverlayPluginWSServerContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="24"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding ConnectionCardTitle}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding ConnectionStateLabel}" />

                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppAccentBrush}"
                           Text="{Binding ConnectionStateText}" />

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal">
                    <Button MinWidth="88"
                            Padding="16,8"
                            Margin="0,0,10,0"
                            Command="{Binding StartCommand}"
                            Content="{Binding StartButtonLabel}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button MinWidth="88"
                            Padding="16,8"
                            Command="{Binding StopCommand}"
                            Content="{Binding StopButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="24"
                Style="{StaticResource SurfaceCardStyle}">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding RequestCardTitle}" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding RequestSectionLabel}" />

                <WrapPanel Margin="0,16,0,0"
                           ItemWidth="148"
                           Orientation="Horizontal">
                    <Button MinWidth="132"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Command="{Binding SendGetLanguageCommand}"
                            Content="{Binding GetLanguageButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button MinWidth="132"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Command="{Binding SendGetVersionCommand}"
                            Content="{Binding GetVersionButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button MinWidth="132"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Command="{Binding SendGetCombatantsCommand}"
                            Content="{Binding GetCombatantsButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button MinWidth="132"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Command="{Binding SendLoadDataCommand}"
                            Content="{Binding LoadDataButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button MinWidth="132"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Command="{Binding SendGetConfigCommand}"
                            Content="{Binding GetConfigButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button MinWidth="132"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Command="{Binding SendGetEnmityCommand}"
                            Content="{Binding GetEnmityButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button MinWidth="132"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Command="{Binding SendGetEncounterCommand}"
                            Content="{Binding GetEncounterButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button MinWidth="132"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Command="{Binding SendGetPartyListCommand}"
                            Content="{Binding GetPartyListButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button MinWidth="132"
                            Margin="0,0,10,0"
                            Padding="14,8"
                            Command="{Binding SendGetCombatDataCommand}"
                            Content="{Binding GetCombatDataButtonLabel}"
                            Style="{StaticResource QuietButtonStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Padding="24"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding ResponseCardTitle}" />

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,8"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource AppTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding EmptyLogMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLogEntries}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
