<UserControl x:Class="FF14Toolkit.App.Views.OverlayPluginInfoContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Padding="24"
                Margin="0,0,16,16"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                           Grid.ColumnSpan="2"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding CharacterSectionTitle}" />

                <TextBlock Grid.Row="2"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding CharacterNameLabel}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding CharacterName}" />

                <TextBlock Grid.Row="4"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding WorldLabel}" />
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding WorldName}" />

                <TextBlock Grid.Row="6"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding JobIdLabel}" />
                <TextBlock Grid.Row="6"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding JobId}" />

                <TextBlock Grid.Row="8"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding JobNameLabel}" />
                <TextBlock Grid.Row="8"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding JobName}" />

                <TextBlock Grid.Row="10"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding LevelLabel}" />
                <TextBlock Grid.Row="10"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding Level}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.Column="0"
                Padding="24"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                           Grid.ColumnSpan="2"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding StatusSectionTitle}" />

                <TextBlock Grid.Row="2"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding HpLabel}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding HpText}" />

                <TextBlock Grid.Row="4"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding MpLabel}" />
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding MpText}" />

                <TextBlock Grid.Row="6"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding GpLabel}" />
                <TextBlock Grid.Row="6"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding GpText}" />

                <TextBlock Grid.Row="8"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding CpLabel}" />
                <TextBlock Grid.Row="8"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding CpText}" />
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="2"
                Padding="24"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                           Grid.ColumnSpan="2"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding LocationSectionTitle}" />

                <TextBlock Grid.Row="2"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding TerritoryTypeIdLabel}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding TerritoryTypeIdText}" />

                <TextBlock Grid.Row="4"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding MapIdLabel}" />
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding MapIdText}" />

                <TextBlock Grid.Row="6"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding MapNameLabel}" />
                <TextBlock Grid.Row="6"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding MapName}" />

                <TextBlock Grid.Row="8"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding RawCoordinatesLabel}" />
                <TextBlock Grid.Row="8"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding RawCoordinatesText}" />

                <TextBlock Grid.Row="10"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding ConvertedCoordinatesLabel}" />
                <TextBlock Grid.Row="10"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding ConvertedCoordinatesText}" />

                <TextBlock Grid.Row="12"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding HeadingLabel}" />
                <TextBlock Grid.Row="12"
                           Grid.Column="1"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding HeadingText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
