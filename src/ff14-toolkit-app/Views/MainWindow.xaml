<Window x:Class="FF14Toolkit.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:markup="clr-namespace:FF14Toolkit.App.Markup"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:FF14Toolkit.App.ViewModels"
        xmlns:views="clr-namespace:FF14Toolkit.App.Views"
        mc:Ignorable="d"
        Title="{markup:Localize App_Title}"
        Height="820"
        Width="1560"
        MinHeight="820"
        MinWidth="1560"
        Background="{StaticResource AppWindowBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:PlaceholderContentViewModel}">
            <views:PlaceholderContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CraftActionSequenceListContentViewModel}">
            <views:CraftActionSequenceListContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CraftActionSequenceContentViewModel}">
            <views:CraftActionSequenceContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CraftSequenceHotkeySettingsContentViewModel}">
            <views:CraftSequenceHotkeySettingsContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:HotbarContentViewModel}">
            <views:HotbarContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:OverlayPluginWSServerContentViewModel}">
            <views:OverlayPluginWSServerContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:OverlayPluginInfoContentViewModel}">
            <views:OverlayPluginInfoContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SettingsContentViewModel}">
            <views:SettingsContentView />
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="18"
                CornerRadius="28"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Text="{markup:Localize App_Title}" />
                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Style="{StaticResource MutedCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12"
                                             Height="12"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#C95A57" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverlayPluginConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#2F7A57" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextBrush}"
                                               Text="{Binding OverlayPluginCharacterDisplay}" />
                                </StackPanel>

                                <TextBlock Margin="20,4,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}"
                                           Text="{Binding OverlayPluginWorldDisplay}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    MinWidth="68"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding StartOverlayPluginConnectionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                <TextBlock Text="{Binding OverlayPluginStartButtonLabel}" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ShellNavigationItemViewModel}">
                                <StackPanel>
                                    <Button Margin="0,0,0,8"
                                            Command="{Binding InvokeCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NavigationGroupButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpandableGroup}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Margin="0,0,0,8"
                                            Command="{Binding InvokeCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpandableGroup}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding DisplayName}" />
                                    </Button>

                                    <ItemsControl Margin="12,0,0,8"
                                                  ItemsSource="{Binding Children}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:ShellNavigationItemViewModel}">
                                                <Button Margin="0,0,0,6"
                                                        Command="{Binding InvokeCommand}"
                                                        Style="{StaticResource NavigationChildButtonStyle}">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <Border Padding="14"
                            Style="{StaticResource MutedCardStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"
                                       Text="Language" />
                            <ComboBox Margin="0,10,0,0"
                                      ItemsSource="{Binding SupportedLanguages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource ToolkitComboBoxStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="18,14"
                    CornerRadius="20"
                    Style="{StaticResource TintedCardStyle}">
                <TextBlock FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Text="{Binding CurrentContentViewModel.DisplayName}" />
            </Border>

            <ContentControl Grid.Row="2"
                            Content="{Binding CurrentContentViewModel}" />
        </Grid>
    </Grid>
</Window>
