<UserControl x:Class="FF14Toolkit.App.Views.SettingsContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="24"
                Background="#FFFDF8"
                BorderBrush="#D5D2C7"
                BorderThickness="1"
                CornerRadius="24">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#233D2E"
                           Text="{Binding LanguageCardTitle}" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="#5D675F"
                           TextWrapping="Wrap"
                           Text="{Binding LanguageCardDescription}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Padding="20"
                Background="#FFFDF8"
                BorderBrush="#D5D2C7"
                BorderThickness="1"
                CornerRadius="24">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#233D2E"
                           Text="{Binding CachePathTitle}" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="#5D675F"
                           TextWrapping="Wrap"
                           Text="{Binding CachePathDescription}" />
                <TextBlock Margin="0,12,0,0"
                           FontFamily="Consolas"
                           Foreground="#274936"
                           TextWrapping="Wrap"
                           Text="{Binding CacheRootPath}" />
                <TextBlock Margin="0,8,0,0"
                           FontFamily="Consolas"
                           Foreground="#274936"
                           TextWrapping="Wrap"
                           Text="{Binding CacheIconsPath}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
