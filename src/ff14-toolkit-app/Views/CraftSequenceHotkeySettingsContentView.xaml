<UserControl x:Class="FF14Toolkit.App.Views.CraftSequenceHotkeySettingsContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Padding="24"
            Style="{StaticResource SurfaceCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="16"
                       Foreground="{StaticResource AppMutedTextBrush}"
                       Text="{Binding OverlayOnlyNotice}" />

            <Border Grid.Row="2"
                    Padding="0,0,0,10"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="158" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding EnabledColumnLabel}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding HotkeyColumnLabel}" />
                    <TextBlock Grid.Column="2"
                               Margin="8,0,8,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding SequenceColumnLabel}" />
                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding RepeatColumnLabel}" />
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding HotkeySlots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10,0,10"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="158" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox Grid.Column="1"
                                                 Margin="0,0,8,0"
                                                 MinHeight="36"
                                                 VerticalContentAlignment="Center"
                                                 PreviewMouseLeftButtonDown="OnHotKeyTextBoxPreviewMouseLeftButtonDown"
                                                 GotKeyboardFocus="OnHotKeyTextBoxGotKeyboardFocus"
                                                 LostKeyboardFocus="OnHotKeyTextBoxLostKeyboardFocus"
                                                 PreviewKeyDown="OnHotKeyTextBoxPreviewKeyDown"
                                                 PreviewTextInput="OnHotKeyTextBoxPreviewTextInput"
                                                 Text="{Binding HotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ToolkitTextBoxStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#2F7A57" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <ComboBox Grid.Column="2"
                                                  Margin="8,0,8,0"
                                                  ItemsSource="{Binding DataContext.AvailableSequences, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedSequence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource ToolkitComboBoxStyle}" />

                                        <TextBox Grid.Column="3"
                                                 Width="96"
                                                 HorizontalAlignment="Center"
                                                 Text="{Binding RepeatCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ToolkitTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           Text="{Binding EmptySequencesMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvailableSequences.Count}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Row="6"
                    HorizontalAlignment="Left"
                    MinWidth="88"
                    Padding="16,8"
                    Command="{Binding SaveCommand}"
                    Content="{Binding SaveButtonLabel}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
